global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - /etc/prometheus/prometheus-alerts.yml
scrape_configs:
  - job_name: getsocs-api
    metrics_path: /internal/metrics/prometheus
    authorization:
      credentials_file: /run/secrets/getsocs_metrics_token
    static_configs:
      - targets: ["127.0.0.1:3001"]
