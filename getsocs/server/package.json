{
  "name": "market-backend-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test TEST_DB_FILE=server.test.json jest --runInBand",
    "test:ci": "jest --runInBand --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "env:check": "node scripts/check-env.js",
    "db:bootstrap": "node scripts/bootstrap-mysql.js",
    "db:migrate:json": "node scripts/migrate-json-to-mysql.js",
    "db:verify": "node scripts/verify-mysql.js",
    "db:export": "node scripts/export-mysql-to-json.js",
    "perf:baseline": "node scripts/benchmark.js --runs=3 --output=../docs/performance/baseline.local.json && node scripts/performance-report-markdown.js ../docs/performance/baseline.local.json ../docs/performance/baseline.local.md \"Getsocs baseline benchmark\"",
    "perf:final": "node scripts/benchmark.js --runs=3 --output=../docs/performance/final.local.json && node scripts/performance-report-markdown.js ../docs/performance/final.local.json ../docs/performance/final.local.md \"Getsocs final benchmark\"",
    "storage:migrate": "node scripts/migrate-local-uploads-to-object-storage.js",
    "storage:verify": "node scripts/verify-object-storage.js",
    "db:backup": "bash scripts/backup-mysql.sh",
    "db:restore": "bash scripts/restore-mysql.sh",
    "perf:infrastructure": "node scripts/collect-infrastructure-baseline.js ../docs/performance/infrastructure.local.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "3.23.2",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.0.0",
    "nodemon": "^3.0.1",
    "pm2": "^7.0.3",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "qs": "^6.15.4"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 10,
        "functions": 15,
        "lines": 20,
        "statements": 20
      }
    }
  }
}
